/**
 * dsh-side-chat — CLIENT half (browser bundle).
 *
 * Hand-written in the DSH browser module convention, exactly like
 * dsh-usage-monitor: the shell loads this file at
 * /plugins/dsh-side-chat/client.js, and `window.__ModuleLoader__.load`
 * registers one module whose factory receives `require`. No build step, so the
 * artifact is readable and fails loudly at load time if a future shell changes
 * the convention.
 *
 * Everything below is deliberately self-contained. The only runtime dependency
 * is `react`, which the shell kernel already provides; the small amount of
 * chrome the in-repo package imported from internal `@deepseek-ai/dsh-client-*`
 * packages is re-implemented here, so this bundle cannot break because an
 * internal package's exports moved between releases.
 */

window.__ModuleLoader__.load({
  id: 'dsh-side-chat',
  factory: (require) => {
    var module = { exports: {} }
    var exports = module.exports
    Object.defineProperty(exports, Symbol.toStringTag, { value: 'Module' })

    var React = require('react')
    var el = React.createElement
    var useState = React.useState
    var useEffect = React.useEffect
    var useRef = React.useRef
    var useSyncExternalStore = React.useSyncExternalStore

    // ── constants ──────────────────────────────────────────────────────────
    /** Transcript anchor the launcher is scoped to (ui-chat owns it). */
    var TURN_SELECTOR = '[data-chat-turn]'
    /** Transcript scrollport, used to read the surrounding turns as context. */
    var TRANSCRIPT_SELECTOR = '[data-conversation-region="chat"], [data-conversation-scroll]'
    /** Longest selection one question carries; the side Session already has the conversation. */
    var QUOTE_MAX_CODE_POINTS = 2000
    /** Longest tool output one row keeps: a glance surface, not a log viewer. */
    var TOOL_OUTPUT_MAX_CODE_POINTS = 1200
    /** Panel width: a docked side column, not a second window. */
    var PANEL_WIDTH = 380
    /** Collapsed panel height: the header strip alone, so it stays reachable. */
    var PANEL_MINIMIZED_HEIGHT = 42
    /** Host half's summarization endpoint (same-origin). */
    var SUMMARIZE_ROUTE = '/side-chat/summarize'
    /**
     * Transcript budget handed to the host summarizer, in code points. Far larger
     * than the fallback excerpt because a model-written briefing can absorb a
     * whole conversation; the host truncates to its own ceiling regardless.
     */
    var SUMMARIZE_INPUT_CODE_POINTS = 24000
    /** How long the panel waits for a briefing before falling back. */
    var SUMMARIZE_TIMEOUT_MS = 70000

    // ── copy (zh + en, resolved from the document language) ────────────────
    // The status line states what this build actually does. The in-repo
    // original seeds a host-side *ephemeral* fork; DSH 0.2.0-rc.2 has no such
    // host API, so this build runs the side conversation in a DETACHED BLANK
    // Session — it inherits no parent conversation and belongs to no Workspace —
    // and says so rather than pretending the conversation is throwaway.
    var COPY = {
      zh: {
        ask: '提问',
        title: '侧边对话',
        collapse: '折叠侧边对话',
        expand: '展开侧边对话',
        close: '关闭侧边对话',
        starting: '正在准备侧边对话…',
        empty: '选中正文里的文字后直接提问。这里不会重放主对话。',
        status: '独立会话：不继承主对话、不归入项目工作区、不占用主会话上下文。',
        context: '随问附上',
        contextSummary: '模型摘要',
        contextBusy: '正在总结当前会话…',
        contextFallback: '会话片段（摘要不可用）',
        contextTurns: '前文轮次',
        contextNone: '仅选中片段',
        contextFailed: '摘要失败，已改用会话片段：',
        failed: '侧边对话出错',
        quoted: '引用',
        placeholder: '问一个后续问题…',
        send: '发送',
        stop: '停止',
      },
      en: {
        ask: 'Ask',
        title: 'Side chat',
        collapse: 'Collapse side chat',
        expand: 'Expand side chat',
        close: 'Close side chat',
        starting: 'Preparing the side chat…',
        empty: 'Select text in the transcript, then ask. The main conversation is not replayed.',
        status: 'Detached session: inherits nothing, joins no workspace, costs no main-conversation context.',
        context: 'Sending with',
        contextSummary: 'a model briefing',
        contextBusy: 'Summarizing this conversation…',
        contextFallback: 'a transcript excerpt (no briefing available)',
        contextTurns: 'preceding turns',
        contextNone: 'selection only',
        contextFailed: 'Summarization failed; sending a transcript excerpt instead:',
        failed: 'Side chat failed',
        quoted: 'Quoted',
        placeholder: 'Ask a follow-up…',
        send: 'Send',
        stop: 'Stop',
      },
    }

    /** Resolve copy for the current document language, defaulting to English. */
    function resolveCopy() {
      var lang = (typeof document !== 'undefined' && document.documentElement.lang) || ''
      return String(lang).toLowerCase().indexOf('zh') === 0 ? COPY.zh : COPY.en
    }

    // ── transcript fold (mirror of the in-repo transcript.ts) ──────────────
    /**
     * Cut text to a code-point budget without splitting a surrogate pair.
     * @param {string} value - source text.
     * @param {number} maximum - maximum number of code points to keep.
     * @returns {string} the text, or its longest allowed prefix plus an ellipsis.
     */
    function truncateCodePoints(value, maximum) {
      var count = 0
      var end = 0
      var iterator = String(value)[Symbol.iterator]()
      for (var step = iterator.next(); !step.done; step = iterator.next()) {
        if (count === maximum) return value.slice(0, end) + '…'
        count += 1
        end += step.value.length
      }
      return value
    }

    /** Join the text blocks of one message's content, ignoring every other kind. */
    function textOf(blocks) {
      var parts = []
      var list = blocks || []
      for (var i = 0; i < list.length; i += 1) {
        if (list[i].type === 'text') parts.push(list[i].text)
      }
      return parts.join('\n\n')
    }

    /**
     * Fold one side Session's visible event window into renderable rows.
     *
     * The inherited prefix is skipped: a forked child marks its seed cut with one
     * tagged `session/end-seed`, so the panel shows this conversation's own turns
     * rather than replaying the main conversation the user is already reading.
     * @param {readonly object[]} entries - contiguous event window of the side Session.
     * @returns {object[]} rows in event order.
     */
    function foldTranscript(entries) {
      var rows = []
      var list = entries || []
      var start = 0
      for (var i = 0; i < list.length; i += 1) {
        var entry = list[i]
        if (entry.type !== 'event') continue
        if (entry.event.type === 'session/end-seed' && entry.event.data && entry.event.data.inherited === true) start = i + 1
      }
      for (var j = start; j < list.length; j += 1) {
        var item = list[j]
        // Client-only live chunks are skipped: the panel renders settled messages.
        if (item.type !== 'event') continue
        var event = item.event
        if (event.type === 'user/message') {
          // Injected context (file notices, skill content, reminders) is the
          // harness talking to the model, not part of this conversation.
          if (!event.data || !event.data.source || event.data.source.kind !== 'user') continue
          var userText = textOf(event.data.content)
          if (userText.trim() !== '') rows.push({ kind: 'user', key: 'u' + String(event.seq), text: userText })
        } else if (event.type === 'assistant/message') {
          var answer = textOf(event.data && event.data.message ? event.data.message.content : [])
          if (answer.trim() === '') continue
          rows.push({
            kind: 'assistant',
            key: 'a' + String(event.seq),
            text: answer,
            interrupted: event.data.interrupted === true,
          })
        } else if (event.type === 'tool/call') {
          rows.push({ kind: 'tool', key: event.data.callId, name: event.data.name, status: 'running', output: '' })
        } else if (event.type === 'tool/result') {
          var content = event.data && event.data.message ? event.data.message.content : []
          var block = content ? content[0] : undefined
          if (!block) continue
          for (var k = 0; k < rows.length; k += 1) {
            if (rows[k].kind === 'tool' && rows[k].key === block.toolCallId) {
              rows[k] = {
                kind: 'tool',
                key: block.toolCallId,
                name: rows[k].name,
                status: block.isError === true || event.data.error !== undefined ? 'error' : 'done',
                output: truncateCodePoints(textOf(block.content), TOOL_OUTPUT_MAX_CODE_POINTS),
              }
              break
            }
          }
        }
      }
      return rows
    }

    // ── minimal markdown for answers (no internal primitives) ──────────────
    /** Render inline `code` spans inside one line of text. */
    function renderInline(text, keyPrefix) {
      var out = []
      var parts = String(text).split('`')
      for (var i = 0; i < parts.length; i += 1) {
        if (i % 2 === 1) out.push(el('code', { key: keyPrefix + 'c' + String(i), style: STYLE.inlineCode }, parts[i]))
        else if (parts[i] !== '') out.push(parts[i])
      }
      return out
    }

    /**
     * Render one answer as paragraph and fenced-code blocks.
     * @param {object} props - the answer text.
     * @returns {object} the rendered block list.
     */
    function AnswerText(props) {
      var lines = String(props.text).split('\n')
      var blocks = []
      var buffer = []
      var fenced = false
      var flush = function (kind) {
        if (buffer.length === 0) return
        blocks.push({ kind: kind, text: buffer.join('\n') })
        buffer = []
      }
      for (var i = 0; i < lines.length; i += 1) {
        var line = lines[i]
        if (line.indexOf('```') === 0) {
          if (fenced) { flush('code'); fenced = false } else { flush('text'); fenced = true }
          continue
        }
        buffer.push(line)
      }
      flush(fenced ? 'code' : 'text')
      return el(
        'div',
        null,
        blocks.map(function (block, index) {
          if (block.kind === 'code') {
            return el('pre', { key: 'b' + String(index), style: STYLE.pre }, el('code', null, block.text))
          }
          return el('p', { key: 'b' + String(index), style: STYLE.p }, renderInline(block.text, 'b' + String(index) + '-'))
        }),
      )
    }

    // ── styles ─────────────────────────────────────────────────────────────
    // Built on the shell's OWN design tokens so the surface follows the active
    // theme instead of fighting it. The names are `--dsw-alias-*` and are read
    // from the shipped theme package; a `--dsh-*` guess renders as its fallback
    // in EVERY theme, which is how an earlier build produced a dark card on a
    // light page. Each fallback below is therefore a light-mode value, and every
    // token used is theme-scoped (light on `body`, dark on
    // `body[data-ds-dark-theme]`).
    var TOKEN = {
      /** Surface fill of a floating action, e.g. the launcher. */
      floating: 'var(--dsw-alias-button-floating-fill, #fff)',
      /** Hover fill of the same. */
      floatingHover: 'var(--dsw-alias-button-floating-hover, #f2f3f5)',
      /** Panel fill: the opaque page base, so the panel reads as a real column. */
      base: 'var(--dsw-alias-bg-base, #fff)',
      /** Primary label colour (near-black in light, near-white in dark). */
      label: 'var(--dsw-alias-label-primary, #1a1a1a)',
      /** Hairline and stronger borders. */
      border: 'var(--dsw-alias-border-l1, rgba(0,0,0,.04))',
      borderStrong: 'var(--dsw-alias-border-l3, rgba(0,0,0,.12))',
      /** Recessed fill for code blocks and inline code. */
      recessed: 'var(--dsw-alias-interactive-bg-hover, rgba(0,0,0,.04))',
      /** Selection/message tint for the user's own turn. */
      bubble: 'var(--dsw-alias-interactive-bg-hover, rgba(0,0,0,.045))',
      /** Primary action fill, from the design system's own button ramp. */
      primary: 'var(--dsw-alias-button-primary-fill, #4a7dff)',
      /** Foreground on the primary fill. */
      primaryText: 'var(--dsw-alias-label-primary-foreground, #fff)',
      /** Error text. */
      danger: 'var(--dsw-alias-state-error-primary, #e5484d)',
      /** Elevation of a floating card. */
      elevation: 'var(--dsw-elevation-prominent, 0 3px 8px rgba(0,0,0,.04), 0 0 20px rgba(0,0,0,.05))',
      radius: 'var(--dsw-radius-md, 8px)',
      radiusSm: 'var(--dsw-radius-sm, 6px)',
    }

    var STYLE = {
      launcher: {
        position: 'fixed', zIndex: 60, transform: 'translate(-50%, -100%)',
        padding: '5px 11px', fontSize: '12px', lineHeight: '18px',
        borderRadius: TOKEN.radius,
        border: '1px solid ' + TOKEN.borderStrong,
        background: TOKEN.floating, color: TOKEN.label, cursor: 'pointer',
        boxShadow: TOKEN.elevation, whiteSpace: 'nowrap',
        fontFamily: 'inherit', fontWeight: 500,
      },
      launcherHover: { background: TOKEN.floatingHover },
      panel: {
        position: 'fixed', top: 0, right: 0, bottom: 0, width: String(PANEL_WIDTH) + 'px',
        zIndex: 50, display: 'flex', flexDirection: 'column',
        borderLeft: '1px solid ' + TOKEN.borderStrong,
        background: TOKEN.base, color: TOKEN.label,
        boxSizing: 'border-box',
      },
      panelMinimized: { bottom: 'auto', height: String(PANEL_MINIMIZED_HEIGHT) + 'px' },
      header: {
        display: 'flex', alignItems: 'center', justifyContent: 'space-between',
        gap: '8px', padding: '10px 12px', borderBottom: '1px solid ' + TOKEN.border,
      },
      title: { fontSize: '13px', fontWeight: 600 },
      headerActions: { display: 'flex', alignItems: 'center', gap: '2px', flex: 'none' },
      iconButton: {
        border: 'none', background: 'transparent', color: TOKEN.label, cursor: 'pointer',
        fontSize: '15px', lineHeight: '20px', padding: '1px 7px', borderRadius: TOKEN.radiusSm,
        fontFamily: 'inherit',
      },
      close: {
        border: 'none', background: 'transparent', color: TOKEN.label, cursor: 'pointer',
        fontSize: '18px', lineHeight: '20px', padding: '1px 7px', borderRadius: TOKEN.radiusSm,
      },
      rows: { flex: 1, overflowY: 'auto', padding: '10px 12px', display: 'flex', flexDirection: 'column', gap: '10px' },
      hint: { fontSize: '12px', opacity: 0.6, lineHeight: '18px' },
      user: {
        alignSelf: 'flex-end', maxWidth: '88%', padding: '6px 10px', borderRadius: TOKEN.radius,
        background: TOKEN.bubble, fontSize: '13px', whiteSpace: 'pre-wrap', overflowWrap: 'anywhere',
      },
      assistant: { alignSelf: 'stretch', fontSize: '13px', lineHeight: '20px', minWidth: 0 },
      p: { margin: '0 0 8px', whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' },
      pre: {
        margin: '0 0 8px', padding: '8px', borderRadius: TOKEN.radiusSm, overflowX: 'auto',
        background: TOKEN.recessed, fontSize: '12px',
      },
      inlineCode: { background: TOKEN.recessed, padding: '1px 4px', borderRadius: '3px', fontSize: '12px' },
      interrupted: { opacity: 0.5, fontSize: '12px' },
      tool: { border: '1px solid ' + TOKEN.border, borderRadius: TOKEN.radiusSm, padding: '6px 8px', fontSize: '12px' },
      toolError: { borderColor: TOKEN.danger },
      toolName: { fontWeight: 600, marginBottom: '4px' },
      toolOutput: { margin: 0, maxHeight: '160px', overflow: 'auto', opacity: 0.8, whiteSpace: 'pre-wrap' },
      error: { padding: '6px 12px', fontSize: '12px', color: TOKEN.danger, overflowWrap: 'anywhere' },
      composer: { borderTop: '1px solid ' + TOKEN.border, padding: '10px 12px', display: 'flex', flexDirection: 'column', gap: '8px' },
      quote: {
        display: 'flex', gap: '6px', fontSize: '12px', opacity: 0.75,
        borderLeft: '2px solid ' + TOKEN.borderStrong, paddingLeft: '8px',
        maxHeight: '72px', overflow: 'hidden',
      },
      quoteLabel: { flex: 'none', fontWeight: 600 },
      quoteText: { overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' },
      status: { fontSize: '11px', lineHeight: '15px', opacity: 0.5 },
      context: { fontSize: '11px', lineHeight: '15px', opacity: 0.65 },
      contextNote: { fontSize: '11px', lineHeight: '15px', opacity: 0.5, overflowWrap: 'anywhere' },
      input: {
        width: '100%', minHeight: '60px', resize: 'vertical', boxSizing: 'border-box',
        font: 'inherit', fontSize: '13px', padding: '8px', borderRadius: TOKEN.radiusSm,
        border: '1px solid ' + TOKEN.borderStrong, background: 'transparent', color: TOKEN.label,
      },
      actions: { display: 'flex', justifyContent: 'flex-end', gap: '8px' },
      button: {
        padding: '5px 12px', fontSize: '12px', borderRadius: TOKEN.radiusSm, cursor: 'pointer',
        border: '1px solid ' + TOKEN.borderStrong, background: 'transparent', color: TOKEN.label,
      },
      buttonPrimary: {
        padding: '5px 12px', fontSize: '12px', borderRadius: TOKEN.radiusSm, cursor: 'pointer',
        border: '1px solid transparent', background: TOKEN.primary, color: TOKEN.primaryText,
      },
      buttonDisabled: { opacity: 0.45, cursor: 'default' },
    }

    /** Subscribe one component to a DSH snapshot store. */
    function useStore(store) {
      return useSyncExternalStore(
        function (listener) { return store.subscribe(listener) },
        function () { return store.getSnapshot() },
      )
    }

    /** A minimal synchronous observable store in the `dsh-client-store` shape. */
    function createStore(initial) {
      var value = initial
      var listeners = new Set()
      return {
        getSnapshot: function () { return value },
        subscribe: function (listener) {
          listeners.add(listener)
          return function () { listeners.delete(listener) }
        },
        set: function (next) {
          value = next
          listeners.forEach(function (listener) { listener() })
        },
      }
    }

    // ── the side-chat controller (mirror of the in-repo controller.ts) ─────
    /**
     * Owns the side conversation: seeds it from the current Session, forwards
     * prompts, folds its transcript, and drops every reference on close.
     * @param {object} sessions - the client `sessions` service.
     * @param {object} viewStore - observable panel state.
     * @param {object} rowsStore - observable folded rows.
     * @returns {object} the controller face the layer component uses.
     */
    /**
     * Owns the side conversation: seeds a DETACHED blank Session, obtains a
     * bounded briefing of the main conversation from the HOST half, sends the
     * first question with that briefing, folds the transcript, and drops every
     * reference on close.
     *
     * The Session is created with no workspace and no cwd, so it belongs to no
     * Workspace and inherits no parent conversation. It is blank until the first
     * turn starts, which is what keeps it out of the session list until it is
     * actually used.
     * @param {object} sessions - the client `sessions` service.
     * @param {object} viewStore - observable panel state.
     * @param {object} rowsStore - observable folded rows.
     * @param {(source: string) => Promise<{summary: string, error: string|null}>} summarize
     *   host-provided summarizer; resolves with an empty summary on any failure.
     * @returns {object} the controller face the layer component uses.
     */
    function createController(sessions, viewStore, rowsStore, summarize) {
      var reference
      var detach
      var starting
      var generation = 0

      var setView = function (patch) {
        viewStore.set(Object.assign({}, viewStore.getSnapshot(), patch))
      }

      var describe = function (error) {
        return error instanceof Error ? error.message : String(error)
      }

      /** Quote one selection as a Markdown blockquote the model can read. */
      var quoteBlock = function (quote) {
        return quote.split('\n').map(function (line) { return '> ' + line }).join('\n')
      }

      var refold = function () {
        if (reference === undefined) return
        rowsStore.set(foldTranscript(reference.binding.eventSource.getSnapshot().entries))
      }

      var syncRunning = function () {
        if (reference === undefined) return
        var running = reference.binding.session.getSnapshot().running === true
        if (running !== viewStore.getSnapshot().running) setView({ running: running })
      }

      /**
       * Ask the host half for a briefing of the main conversation.
       *
       * Runs in parallel with seeding the side Session, so the wait overlaps the
       * round-trip the fork/create already costs. Every failure path lands on the
       * fallback excerpt; nothing here can make the panel unusable.
       */
      var requestSummary = async function (source, fallback, fallbackTurns, myGeneration) {
        try {
          var result = await summarize(source)
          if (myGeneration !== generation) return
          if (typeof result?.summary === 'string' && result.summary.trim() !== '') {
            setView({ summary: result.summary.trim(), summarizing: false, summaryError: null })
            return
          }
          setView({
            summary: '', summarizing: false,
            summaryError: result?.error ?? 'no briefing returned',
            context: fallback, contextTurns: fallbackTurns,
          })
        } catch (error) {
          if (myGeneration !== generation) return
          setView({
            summary: '', summarizing: false, summaryError: describe(error),
            context: fallback, contextTurns: fallbackTurns,
          })
        }
      }

      var start = async function (myGeneration) {
        var sessionId
        try {
          // No workspaceId and no cwd on purpose: the Session is detached from
          // every Workspace, and it starts blank so it stays out of the list.
          var result = await sessions.create({})
          sessionId = result
        } catch (error) {
          if (myGeneration !== generation) return
          setView({ starting: false, error: describe(error) })
          return
        }
        if (myGeneration !== generation) return
        var next = sessions.retain(sessionId, { source: 'side-chat' })
        reference = next
        try {
          var binding = await next.ready
          if (myGeneration !== generation) {
            next.release()
            reference = undefined
            return
          }
          refold()
          syncRunning()
          var detachRows = binding.eventSource.subscribe(function () { refold() })
          var detachState = binding.session.subscribe(function () { syncRunning() })
          detach = function () { detachRows(); detachState() }
          setView({ starting: false })
        } catch (error) {
          if (myGeneration !== generation) return
          if (reference === next) reference = undefined
          next.release()
          setView({ starting: false, error: describe(error) })
        }
      }

      return {
        view: viewStore,
        rows: rowsStore,
        /**
         * Open the panel, seeding a detached side Session when none is open.
         * A repeated call with the panel already open only moves the quote and
         * its context.
         * @param quote - the selected passage.
         * @param source - whole visible conversation, offered to the host summarizer.
         * @param fallback - the local excerpt used when no briefing is available.
         * @param fallbackTurns - how many turns that excerpt holds.
         */
        open: async function (quote, source, fallback, fallbackTurns) {
          setView({
            open: true, quote: quote,
            // Start on the excerpt so a send is never blocked on the briefing.
            context: fallback, contextTurns: fallbackTurns,
            summary: '', summarizing: true, summaryError: null,
          })
          if (reference !== undefined || starting !== undefined) return
          setView({ starting: true, error: null })
          void requestSummary(source, fallback, fallbackTurns, generation)
          var attempt = start(generation)
          starting = attempt
          var clear = function () { if (starting === attempt) starting = undefined }
          attempt.then(clear, clear)
          await attempt
        },
        /**
         * Send one prompt. The first send carries the briefing (or the excerpt),
         * the quoted passage, and the question in one message, so the model never
         * sees a message that is only preamble; later sends are the question
         * alone.
         */
        ask: function (text) {
          if (reference === undefined) return
          var body = String(text).trim()
          if (body === '') return
          var view = viewStore.getSnapshot()
          var quote = String(view.quote).trim()
          var context = (String(view.summary).trim() !== '' ? String(view.summary) : String(view.context)).trim()
          var parts = []
          if (context !== '') parts.push(context)
          if (quote !== '') parts.push('> ' + quote.split('\n').join('\n> '))
          parts.push(body)
          var prompt = parts.join('\n\n')
          // The context rides the first question only: after that the side
          // Session owns the conversation and re-sending it would double the cost.
          setView({
            draft: '', quote: '', context: '', contextTurns: 0,
            summary: '', summarizing: false, summaryError: null, error: null,
          })
          reference.binding.session.prompt([{ type: 'text', text: prompt }], 'queue').then(function (result) {
            if (result && result.ok === false) setView({ error: result.error.code + ': ' + result.error.message })
          }, function (error) {
            setView({ error: describe(error) })
          })
        },
        /** Stop the side conversation's running turn, if any. */
        stop: function () {
          if (reference !== undefined) void reference.binding.session.cancel()
        },
        /** Collapse the panel to its header strip, keeping the conversation. */
        toggleCollapsed: function () {
          setView({ minimized: !viewStore.getSnapshot().minimized })
        },
        /**
         * Record which surface is carrying the conversation. The shell's right
         * sidebar is a real column, so when it holds the tab the floating panel
         * must not also render — and closing the tab must leave nothing behind.
         * @param docked - whether the sidebar owns the view.
         */
        setDocked: function (docked) {
          setView({ docked: docked === true })
        },
        /** Replace the composer draft. */
        setDraft: function (text) { setView({ draft: String(text) }) },
        /** Discard the open side conversation and drop every local reference. */
        close: function () {
          generation += 1
          if (detach !== undefined) { detach(); detach = undefined }
          if (reference !== undefined) { reference.release(); reference = undefined }
          starting = undefined
          rowsStore.set([])
          viewStore.set({
            open: false, docked: false, minimized: false, starting: false, running: false,
            quote: '', context: '', contextTurns: 0,
            summary: '', summarizing: false, summaryError: null,
            draft: '', error: null,
          })
        },
      }
    }

    // ── transcript context: a host-written briefing, or a local excerpt ─────
    /**
     * Fallback excerpt budget, in code points.
     *
     * The preferred context is a briefing the HOST half writes with the model
     * (a browser plugin cannot call `ctx.llm`). When that call is unavailable or
     * fails, the question still carries what the reader was looking at, bounded
     * to roughly a thousand tokens so a fallback never re-sends a conversation.
     */
    var CONTEXT_BLOCK_MAX_CODE_POINTS = 4000
    /** How many preceding turns the fallback excerpt may draw from. */
    var CONTEXT_TURN_LIMIT = 2

    /** Normalize a turn's rendered text for quoting. */
    function normalizeTurnText(text) {
      return String(text).replace(/\n{3,}/gu, '\n\n').trim()
    }

    /**
     * Read the rendered transcript turns as (role, text) pairs, in order.
     *
     * The transcript is the user's own reading material, so its text is already
     * on screen. Roles come from the `data-chat-turn` convention when it names
     * one; an unlabelled turn is reported as the assistant's, which is the common
     * case for a passage worth asking about.
     * @returns {{ role: string, text: string }[]} non-empty turns in document order.
     */
    function readTranscriptTurns() {
      var root = document.querySelector(TRANSCRIPT_SELECTOR)
      var scope = root === null ? document : root
      var nodes = scope.querySelectorAll(TURN_SELECTOR)
      var turns = []
      for (var i = 0; i < nodes.length; i += 1) {
        var node = nodes[i]
        var text = normalizeTurnText(node.innerText || node.textContent || '')
        if (text === '') continue
        var marked = String(node.getAttribute('data-chat-turn') || '').toLowerCase()
        var role = marked.indexOf('user') !== -1 ? 'User' : 'Assistant'
        turns.push({ role: role, text: text })
      }
      return turns
    }

    /** Render turns as a role-labelled transcript, left out whole when over budget. */
    function renderTurns(turns, maxCodePoints) {
      var parts = []
      var used = 0
      for (var i = 0; i < turns.length; i += 1) {
        var piece = '[' + turns[i].role + ']\n' + turns[i].text
        if (used + piece.length > maxCodePoints) break
        parts.push(piece)
        used += piece.length
      }
      return parts.join('\n\n')
    }

    /**
     * Build the FALLBACK context for a selection: the whole conversation when it
     * fits the fallback budget, otherwise the turns immediately before the
     * selection. A turn that would overflow is left out whole rather than
     * included truncated, so the model never reads half a turn as if it were
     * whole — including the case where nothing fits and there is no excerpt.
     * @param {string} selectedText - the passage the question is about.
     * @returns {{ block: string, turns: number }} the block ('' when nothing fits) and its turn count.
     */
    function buildContextBlock(selectedText) {
      var turns = readTranscriptTurns()
      if (turns.length === 0) return { block: '', turns: 0 }
      // The whole conversation fits only when every turn made it in.
      var whole = renderTurns(turns, CONTEXT_BLOCK_MAX_CODE_POINTS)
      if (whole !== '' && turns.length <= CONTEXT_TURN_LIMIT + 1) return { block: whole, turns: turns.length }
      // Long conversation, or a turn too large to include: prefer what came
      // before the selection, and drop anything that still does not fit.
      var anchor = -1
      for (var i = 0; i < turns.length; i += 1) {
        if (turns[i].text.indexOf(selectedText) !== -1) anchor = i
      }
      var end = anchor === -1 ? turns.length - 1 : anchor - 1
      if (end < 0) return { block: '', turns: 0 }
      var picked = turns.slice(Math.max(0, end - CONTEXT_TURN_LIMIT + 1), end + 1)
      var block = renderTurns(picked, CONTEXT_BLOCK_MAX_CODE_POINTS)
      // `renderTurns` stops at the first turn that does not fit, so the rendered
      // count is what actually survived, not how many were offered.
      var rendered = block === '' ? 0 : block.split('\n\n[').length
      return { block: block, turns: block === '' ? 0 : rendered }
    }

    // ── the surface ────────────────────────────────────────────────────────
    /**
     * Read the current selection when it sits inside a transcript turn.
     * @returns {object|null} the quote, the summarizer input, the fallback context, and the launcher anchor; null when nothing qualifies.
     */
    function readSelection() {
      var selection = window.getSelection()
      if (selection === null || selection.isCollapsed || selection.rangeCount === 0) return null
      var text = selection.toString().trim()
      if (text === '') return null
      var range = selection.getRangeAt(0)
      var anchor = range.commonAncestorContainer
      // Compare against the numeric constant rather than the `Node` global: the
      // DOM is the shell's, and this must not throw where that global is absent.
      var element = anchor.nodeType === 1 ? anchor : anchor.parentElement
      // Scope the offer to the transcript: a selection in the sidebar, a tooltip,
      // or the composer never offers the launcher.
      if (element === null || element === undefined || element.closest(TURN_SELECTOR) === null) return null
      var rect = range.getBoundingClientRect()
      var quote = truncateCodePoints(text, QUOTE_MAX_CODE_POINTS)
      var context = buildContextBlock(quote)
      var turns = readTranscriptTurns()
      return {
        text: quote,
        // What the host summarizer is offered: the whole conversation it can see,
        // far above the fallback budget because a briefing absorbs it.
        source: renderTurns(turns, SUMMARIZE_INPUT_CODE_POINTS),
        context: context.block,
        contextTurns: context.turns,
        x: rect.left + rect.width / 2,
        y: rect.top,
      }
    }

    /**
     * Frame-wide side-chat layer: the selection launcher and the docked panel.
     * @param {object} props - the inject face this contribution was registered with.
     * @returns {object} the launcher and panel, or nothing while both are closed.
     */
    function SideChatLayer(props) {
      var t = resolveCopy()
      var controller = props.sideChat
      var view = useStore(controller.view)
      var rows = useStore(controller.rows)
      var offerState = useState(null)
      var offer = offerState[0]
      var setOffer = offerState[1]
      var hoverState = useState(false)
      var hovering = hoverState[0]
      var setHovering = hoverState[1]
      var rowsRef = useRef(null)

      useEffect(function () {
        var update = function () { setOffer(readSelection()) }
        document.addEventListener('mouseup', update)
        document.addEventListener('keyup', update)
        document.addEventListener('scroll', update, true)
        return function () {
          document.removeEventListener('mouseup', update)
          document.removeEventListener('keyup', update)
          document.removeEventListener('scroll', update, true)
        }
      }, [])

      useEffect(function () {
        if (!view.open) return undefined
        var onKeyDown = function (event) { if (event.key === 'Escape') controller.close() }
        document.addEventListener('keydown', onKeyDown)
        return function () { document.removeEventListener('keydown', onKeyDown) }
      }, [view.open, controller])

      useEffect(function () {
        var node = rowsRef.current
        if (node === null) return
        node.scrollTop = node.scrollHeight
      }, [rows, view.open])

      var send = function () { controller.ask(view.draft) }

      var launcher = (!view.open && offer !== null)
        ? el(
          'button',
          {
            type: 'button',
            'data-side-chat': 'launcher',
            style: Object.assign(
              {},
              STYLE.launcher,
              { left: String(offer.x) + 'px', top: String(offer.y) + 'px' },
              hovering ? STYLE.launcherHover : null,
            ),
            // Keep the selection alive: a default mousedown collapses it first.
            onMouseDown: function (event) { event.preventDefault() },
            onMouseEnter: function () { setHovering(true) },
            onMouseLeave: function () { setHovering(false) },
            onClick: function () {
              // The conversation is captured here, at the moment the reader asks,
              // from the turns currently on screen: `source` goes to the host
              // summarizer, `context` is the fallback used if it returns nothing.
              controller.open(offer.text, offer.source, offer.context, offer.contextTurns)
              setOffer(null)
              setHovering(false)
            },
          },
          t.ask,
        )
        : null

      var rowNodes = rows.map(function (row) {
        if (row.kind === 'tool') {
          return el(
            'div',
            { key: row.key, style: row.status === 'error' ? Object.assign({}, STYLE.tool, STYLE.toolError) : STYLE.tool },
            el('div', { style: STYLE.toolName }, row.name),
            row.output === '' ? null : el('pre', { style: STYLE.toolOutput }, row.output),
          )
        }
        if (row.kind === 'user') return el('div', { key: row.key, style: STYLE.user }, row.text)
        return el(
          'div',
          { key: row.key, style: STYLE.assistant },
          el(AnswerText, { text: row.text }),
          row.interrupted ? el('div', { style: STYLE.interrupted }, '…') : null,
        )
      })

      var panelHeader = el(
        'div',
        { style: STYLE.header },
        el('span', { style: STYLE.title }, t.title),
        el(
          'div',
          { style: STYLE.headerActions },
          view.docked ? null : el(
            'button',
            {
              type: 'button',
              style: STYLE.iconButton,
              'aria-label': view.minimized ? t.expand : t.collapse,
              'data-side-chat': 'collapse',
              onClick: function () { controller.toggleCollapsed() },
            },
            view.minimized ? '\u25a1' : '\u2013',
          ),
          el(
            'button',
            {
              type: 'button',
              style: STYLE.close,
              'aria-label': t.close,
              'data-side-chat': 'close',
              onClick: function () { controller.close() },
            },
            '\u00d7',
          ),
        ),
      )

      // Collapsed keeps the header strip on screen: the conversation survives, so
      // folding it away is a glance decision rather than a discard.
      // When the shell's own right sidebar is carrying the tab, the floating
      // panel stands down: one surface, not two.
      var panel = view.open && !view.docked
        ? el(
          'aside',
          {
            style: view.minimized ? Object.assign({}, STYLE.panel, STYLE.panelMinimized) : STYLE.panel,
            'aria-label': t.title,
            'data-side-chat': 'panel',
            'data-collapsed': view.minimized ? 'true' : undefined,
          },
          panelHeader,
          view.minimized ? null : el(
            'div',
            { style: STYLE.rows, ref: rowsRef, role: 'log', 'aria-label': t.title },
            view.starting ? el('div', { style: STYLE.hint }, t.starting) : null,
            (!view.starting && rows.length === 0) ? el('div', { style: STYLE.hint }, t.empty) : null,
            rowNodes,
          ),
          view.minimized || view.error === null ? null : el('div', { style: STYLE.error, role: 'alert' }, t.failed + ': ' + view.error),
          view.minimized ? null : el(
            'div',
            { style: STYLE.composer },
            el('div', { style: STYLE.status, 'data-side-chat': 'status' }, t.status),
            // What the first question will actually carry, so the cost of the
            // side conversation is visible before it is spent.
            view.quote === ''
              ? null
              : el(
                'div',
                { style: STYLE.context, 'data-side-chat': 'context' },
                t.context + ': ',
                view.summarizing && view.summary === ''
                  ? t.contextBusy
                  : (view.summary !== ''
                    ? t.contextSummary
                    : (view.contextTurns > 0
                      ? t.contextFallback + ' — ' + String(view.contextTurns) + ' ' + t.contextTurns
                      : t.contextFallback)),
              ),
            view.summaryError === null || view.quote === ''
              ? null
              : el(
                'div',
                { style: STYLE.contextNote, 'data-side-chat': 'context-note' },
                t.contextFailed + ' ' + view.summaryError,
              ),
            view.quote === ''
              ? null
              : el(
                'div',
                { style: STYLE.quote },
                el('span', { style: STYLE.quoteLabel }, t.quoted),
                el('span', { style: STYLE.quoteText }, view.quote),
              ),
            el('textarea', {
              style: STYLE.input,
              value: view.draft,
              placeholder: t.placeholder,
              'aria-label': t.placeholder,
              onChange: function (event) { controller.setDraft(event.target.value) },
              onKeyDown: function (event) {
                if (event.key !== 'Enter' || event.shiftKey || event.nativeEvent.isComposing) return
                event.preventDefault()
                send()
              },
            }),
            el(
              'div',
              { style: STYLE.actions },
              view.running
                ? el('button', { type: 'button', style: STYLE.button, onClick: function () { controller.stop() } }, t.stop)
                : el(
                  'button',
                  {
                    type: 'button',
                    style: view.draft.trim() === '' ? Object.assign({}, STYLE.buttonPrimary, STYLE.buttonDisabled) : STYLE.buttonPrimary,
                    disabled: view.draft.trim() === '',
                    onClick: send,
                  },
                  t.send,
                ),
            ),
          ),
        )
        : null

      return el(React.Fragment, null, launcher, panel)
    }

    // ── plugin body ────────────────────────────────────────────────────────
    /** Required client services: the Session object layer and the slot registry. */
    var inject = ['sessions', 'slots']

    /**
     * Ask the host half for a briefing. Never throws: a transport failure, a
     * timeout, or a non-JSON reply all resolve to an empty summary with a reason,
     * which the controller turns into the transcript-excerpt fallback.
     * @param {string} source - the visible conversation to summarize.
     * @returns {Promise<{summary: string, error: string|null}>}
     */
    async function requestBriefing(source) {
      if (typeof source !== 'string' || source.trim() === '') return { summary: '', error: 'no conversation to summarize' }
      var abort = new AbortController()
      var timer = setTimeout(function () { abort.abort() }, SUMMARIZE_TIMEOUT_MS)
      try {
        var response = await fetch(SUMMARIZE_ROUTE, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text: source, maxChars: SUMMARIZE_INPUT_CODE_POINTS }),
          signal: abort.signal,
        })
        if (!response.ok) return { summary: '', error: 'summarize route replied ' + String(response.status) }
        var payload = await response.json()
        if (typeof payload?.summary === 'string' && payload.summary.trim() !== '') {
          return { summary: payload.summary.trim(), error: null }
        }
        return { summary: '', error: typeof payload?.error === 'string' ? payload.error : 'no briefing returned' }
      } catch (error) {
        return { summary: '', error: error instanceof Error ? error.message : String(error) }
      } finally {
        clearTimeout(timer)
      }
    }

    /**
     * Client plugin body: build one controller, then register the two seats that
     * can carry it — the shell's own right sidebar (preferred: it is a real
     * column with real collapse behaviour) and a floating overlay (fallback for a
     * tree that does not mount `@deepseek-ai/dsh-client-ui-sidebar-right`). A
     * missing sidebar degrades to the fallback instead of losing the feature.
     * @param {object} ctx - client root context.
     */
    function apply(ctx) {
      var sessions = ctx.get('sessions')
      var slots = ctx.get('slots')
      if (sessions === undefined || slots === undefined) return

      var viewStore = createStore({
        open: false, docked: false, minimized: false, starting: false, running: false,
        quote: '', context: '', contextTurns: 0,
        summary: '', summarizing: false, summaryError: null,
        draft: '', error: null,
      })
      var rowsStore = createStore([])
      var controller = createController(sessions, viewStore, rowsStore, requestBriefing)

      // ── seat 2: the shell's right sidebar (preferred) ──────────────────────
      var hasSidebar = ctx.get('sidebarRight') !== undefined && ctx.get('sidebarRightTabs') !== undefined
      if (hasSidebar) {
        ctx.effect(function () {
          return ctx.sidebarRightTabs.register({
            id: 'side-chat',
            kind: SIDEBAR_KIND,
            // `extension` is the default band and lets a builtin take the kind
            // over if the shell ever ships its own side chat.
            priority: 'extension',
            title: function () { return resolveCopy().title },
          })
        }, 'side-chat: sidebar type')

        ctx.effect(function () {
          return ctx.slots.inject('sidebar.right.pane.tab', function () {
            return ctx.slots.register({
              name: 'sidebar.right.pane.tab',
              key: 'side-chat',
              inject: function () {
                return {
                  hooks: { sideChatView: controller.view, sideChatRows: controller.rows },
                  sideChat: controller,
                }
              },
            }, SideChatPanel)
          })
        }, 'side-chat: sidebar body')

        // Closing the tab is the panel's close: the two surfaces must not drift.
        ctx.effect(function () {
          return ctx.sidebarRight.registerCloseHandler(SIDEBAR_KIND, function () {
            controller.setDocked(false)
            controller.close()
          })
        }, 'side-chat: sidebar close')
      }

      // ── seat 1: the floating overlay, and the launcher ─────────────────────
      ctx.effect(function () {
        return slots.inject('shell.overlay', function () {
          return slots.register(
            {
              name: 'shell.overlay',
              id: 'side-chat',
              inject: function () {
                return {
                  hooks: { sideChatView: controller.view, sideChatRows: controller.rows },
                  sideChat: controller,
                  /**
                   * Hand the conversation to the shell's sidebar. Returns whether
                   * it was docked, so the caller can fall back to the overlay.
                   * @returns {boolean} true when the sidebar took the tab.
                   */
                  dock: function () {
                    if (!hasSidebar) return false
                    try {
                      ctx.sidebarRight.openTab(SIDEBAR_KIND, { revealIfOpened: true })
                      controller.setDocked(true)
                      return true
                    } catch (error) {
                      // `openTab` throws when no session surface is mounted; the
                      // floating panel is the honest fallback there.
                      console.warn('[side-chat] could not dock into the sidebar:', error)
                      return false
                    }
                  },
                }
              },
            },
            SideChatLayer,
          )
        })
      }, 'side-chat: overlay layer')
    }

    exports.inject = inject
    exports.apply = apply
    exports.SideChatLayer = SideChatLayer
    exports.foldTranscript = foldTranscript
    return module.exports
  },
})
